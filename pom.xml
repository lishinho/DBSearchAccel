            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-core-filter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-core-aggregate</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-core-index</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-fallback</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-sync-full</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-sync-increment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-sync</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-consistency</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
