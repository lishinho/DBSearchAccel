<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dbsearchaccel</groupId>
    <artifactId>db-search-accel</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DBSearchAccel</name>
    <description>Database Complex Query Acceleration Middleware</description>
    <url>https://github.com/dbsearchaccel/db-search-accel</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>DBSearchAccel Team</name>
            <email>dbsearchaccel@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>2.7.18</spring-boot.version>
        <spring-cloud.version>2021.0.8</spring-cloud.version>
        <elasticsearch.version>7.17.9</elasticsearch.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <canal.version>1.1.7</canal.version>
        <sentinel.version>1.8.6</sentinel.version>
        <nacos.version>2.2.4</nacos.version>
        <mysql.version>8.0.33</mysql.version>
        <micrometer.version>1.11.5</micrometer.version>
        <hutool.version>5.8.25</hutool.version>
        <lombok.version>1.18.30</lombok.version>
        <slf4j.version>1.7.36</slf4j.version>
        <jackson.version>2.15.3</jackson.version>
        <junit.version>5.10.1</junit.version>
        <mockito.version>5.8.0</mockito.version>
    </properties>

    <modules>
        <module>dsa-common</module>
        <module>dsa-infrastructure</module>
        <module>dsa-core</module>
        <module>dsa-fallback</module>
        <module>dsa-sync</module>
        <module>dsa-cache</module>
        <module>dsa-plugin</module>
        <module>dsa-consistency</module>
        <module>dsa-monitor</module>
        <module>dsa-gateway</module>
        <module>dsa-sdk</module>
        <module>dsa-admin</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-common-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
