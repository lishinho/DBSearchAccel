            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-infra-es</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
                <artifactId>dsa-infra-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dbsearchaccel</groupId>
